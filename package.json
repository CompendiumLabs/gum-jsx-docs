{
  "name": "gum-jsx-docs",
  "description": "Markdown reference pages and runnable examples for gum-jsx",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dirs": "./src/dirs.ts",
    "./elements/*": "./elements/*",
    "./topics/*": "./topics/*",
    "./visual-tests/*": "./visual-tests/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "bun scripts/check.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "gum-jsx-core": "workspace:*",
    "gum-jsx-math": "workspace:*",
    "typescript": "^7"
  }
}
