{
  "name": "@gum-jsx/docs",
  "version": "1.9.0",
  "description": "Documentation and gallery examples for gum.jsx",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-docs.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "docs",
    "gala",
    "prompt",
    "skills/gum-jsx",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./meta": {
      "types": "./types/meta.d.ts",
      "import": "./src/meta.ts"
    },
    "./dirs": {
      "types": "./types/dirs.d.ts",
      "import": "./src/dirs.ts"
    },
    "./docs/*": "./docs/*",
    "./prompt/*": "./prompt/*",
    "./gala/*": "./gala/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "skill": "bun ./scripts/skill.ts && cd skills && rm -f gum-jsx.skill && zip -r gum-jsx.skill gum-jsx",
    "typecheck": "bun tsc --noEmit",
    "types": "rm -rf types && bun tsc -p tsconfig.types.json",
    "prepublishOnly": "bun run types"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "commander": "^14.0.3",
    "typescript": "^5.9.3"
  }
}
