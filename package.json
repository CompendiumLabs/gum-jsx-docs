{
  "name": "@gum-jsx/docs",
  "description": "Markdown reference pages and runnable examples for gum-jsx",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dirs": "./src/dirs.ts",
    "./prompt/*": "./prompt/*",
    "./docs/elements/*": "./docs/elements/*",
    "./docs/gallery/*": "./docs/gallery/*",
    "./elements/*": "./docs/elements/*",
    "./topics/*": "./docs/gallery/*",
    "./visual-tests/*": "./visual-tests/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test/examples.ts && bun test ./test",
    "skill": "bun scripts/skill.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@gum-jsx/core": "workspace:*",
    "@gum-jsx/math": "workspace:*",
    "typescript": "^7"
  }
}
