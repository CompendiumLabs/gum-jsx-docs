{
  "name": "@gum-jsx/docs",
  "description": "Markdown reference pages and runnable examples for gum-jsx",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dirs": "./src/dirs.ts",
    "./prompt/*": "./prompt/*",
    "./docs/elements/*": "./docs/elements/*",
    "./docs/gallery/*": "./docs/gallery/*",
    "./elements/*": "./docs/elements/*",
    "./topics/*": "./docs/gallery/*",
    "./visual-tests/*": "./visual-tests/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test/examples.ts && bun test ./test",
    "skill": "bun scripts/skill.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@gum-jsx/core": "2.0.0-beta.1",
    "@gum-jsx/math": "2.0.0-beta.1",
    "typescript": "^7"
  },
  "version": "2.0.0-beta.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-docs.git"
  },
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-docs#readme",
  "bugs": {
    "url": "https://github.com/CompendiumLabs/gum-jsx-docs/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs",
    "prompt",
    "visual-tests",
    "scripts/skill.ts"
  ]
}
