{
  "name": "@gum-jsx/docs",
  "description": "Markdown reference pages and runnable examples for Gum",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dirs": "./src/dirs.ts",
    "./docs": "./src/docs.ts",
    "./catalog": "./src/data.ts",
    "./prompt/*": "./prompt/*",
    "./docs/elements/*": "./docs/elements/*",
    "./docs/guides/*": "./docs/guides/*",
    "./docs/gallery/*": "./docs/gallery/*",
    "./elements/*": "./docs/elements/*",
    "./guides/*": "./docs/guides/*",
    "./topics/*": "./docs/gallery/*",
    "./visual-tests/*": "./visual-tests/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "perf": "bun test/perf/run.ts",
    "perf:demos": "bun test/perf/run.ts",
    "test": "bun test/examples.ts && bun test ./test",
    "skill:build": "bun scripts/skill-build.ts",
    "skill:pack": "bun scripts/skill-pack.ts",
    "plugin:build": "bun scripts/plugin-build.ts",
    "plugin:pack": "bun scripts/plugin-pack.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@gum-jsx/core": "2.1.0-beta.0",
    "@gum-jsx/math": "2.1.0-beta.0",
    "@gum-jsx/maps": "2.1.0-beta.0",
    "@gum-jsx/mp4": "2.1.0-beta.0",
    "mitata": "1.0.34",
    "typescript": "^7"
  },
  "version": "2.1.0-beta.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-docs.git"
  },
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-docs#readme",
  "bugs": {
    "url": "https://github.com/CompendiumLabs/gum-jsx-docs/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs",
    "prompt",
    "visual-tests"
  ]
}
